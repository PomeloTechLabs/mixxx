# Build environment image for the OHOS CI (libmixxx + HAP, unsigned).
#
# Reproduces the layout of the local mixxx-ohos-build container so the
# existing scripts (cmake/ohos/build-qt-ohos.sh, packaging/ohos/build-hap.sh)
# run unmodified:
#
#   /apps/harmony                      HarmonyOS command-line tools (linux-x64)
#   /data/out/qt-ohos, qt-host         Qt for OHOS cross build + host tools
#   /data/vcpkg/vcpkg                  vcpkg @ VCPKG_COMMIT, arm64-ohos installed tree
#   /data/src/mixxx                    repo (symlinked to the CI workspace at run time)
#   /data/mixxx-build                  fresh build dir per CI run
#
# The command-line tools zip is not redistributable via a stable public URL;
# either pass OHOS_CMDLINE_TOOLS_URL as a build arg or place the zip next to
# this Dockerfile as command-line-tools.zip. Building the image takes 2-4 h
# (Qt host + cross); do it once per toolchain change, not per commit.
#
# Autonomously generated by an AI Agent.

FROM ubuntu:24.04

ARG OHOS_CMDLINE_TOOLS_URL=
ARG VCPKG_COMMIT=6df3b6ad
ARG VCPKG_PORTS="zlib libflac mp3lame libogg libvorbis libsndfile libebur128 soundtouch taglib rubberband portaudio fftw3 chromaprint opus opusfile"

ENV DEBIAN_FRONTEND=noninteractive \
    OHOS_SDK_ROOT=/apps/harmony/sdk/default/openharmony \
    DEVECO_SDK_HOME=/apps/harmony/sdk

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential clang curl file flex bison gperf git ninja-build \
        cmake python3 python3-pip pkg-config autoconf automake libtool \
        zip unzip xz-utils ca-certificates openssh-client \
        openjdk-17-jdk-headless nodejs \
        libgl1-mesa-dev libegl1 libopengl0 libglib2.0-0 libdbus-1-3 \
        libxkbcommon0 libfontconfig1 libdouble-conversion3 libbrotli1 \
    && rm -rf /var/lib/apt/lists/*

# ---- HarmonyOS command-line tools --------------------------------------
COPY . /data/src/mixxx
RUN if [ -n "$OHOS_CMDLINE_TOOLS_URL" ]; then \
        curl -fsSL -o /tmp/clt.zip "$OHOS_CMDLINE_TOOLS_URL"; \
    elif [ -f /data/src/mixxx/packaging/ohos/ci/command-line-tools.zip ]; then \
        cp /data/src/mixxx/packaging/ohos/ci/command-line-tools.zip /tmp/clt.zip; \
    else \
        echo "ERROR: provide OHOS_CMDLINE_TOOLS_URL or packaging/ohos/ci/command-line-tools.zip" >&2; \
        exit 1; \
    fi \
    && unzip -q /tmp/clt.zip -d /tmp/cltx \
    && clt_dir="$(dirname "$(dirname "$(find /tmp/cltx -name hvigorw -path '*/bin/*' | head -1)")")" \
    && mkdir -p /apps \
    && mv "$clt_dir" /apps/harmony \
    && rm -rf /tmp/clt.zip /tmp/cltx \
    && test -x /apps/harmony/bin/hvigorw \
    && test -f "$OHOS_SDK_ROOT/native/build/cmake/ohos.toolchain.cmake"

# ---- vcpkg dependencies (arm64-ohos, overlay ports from this repo) ------
RUN git clone https://github.com/microsoft/vcpkg /data/vcpkg/vcpkg \
    && git -C /data/vcpkg/vcpkg checkout "$VCPKG_COMMIT" \
    && /data/vcpkg/vcpkg/bootstrap-vcpkg.sh -disableMetrics \
    && /data/vcpkg/vcpkg/vcpkg install $VCPKG_PORTS \
        --triplet arm64-ohos \
        --overlay-ports=/data/src/mixxx/cmake/ohos/ports \
    && rm -rf /data/vcpkg/vcpkg/buildtrees /data/vcpkg/vcpkg/packages \
              /data/vcpkg/vcpkg/downloads

# ---- Qt for OHOS (host tools + cross build, pinned by the repo) ---------
RUN bash /data/src/mixxx/cmake/ohos/checkout-qt-pins.sh /data/qt6 \
    && STAGE=all bash /data/src/mixxx/cmake/ohos/build-qt-ohos.sh \
    && rm -rf /data/build /data/qt6

# Keep the layout build-hap.sh expects, minus everything transient.
RUN rm -rf /data/src/mixxx && mkdir -p /data/src /data/mixxx-build

# Autonomously generated by an AI Agent.
